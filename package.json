{
  "name": "emamendoza-dev-page",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "gitleaks git --redact .",
    "validate": "pnpm format:check && pnpm check && pnpm build && pnpm secrets",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm validate"
  }
}
